<!DOCTYPE html>
<html>
<head><meta name="viewport" content="width=device-width, initial-scale=1">
<title>ADMIN - ARNAUD AFROCHAINE</title>
<style>body{font-family:Arial;background:#0a3d0a;padding:15px;color:white}.card{background:white;color:black;padding:20px;border-radius:12px;margin:10px 0} input{width:90%;padding:12px;margin:8px 0;border:2px solid #0a3d0a;border-radius:8px} button{padding:12px 20px;border:none;border-radius:8px;font-weight:bold;cursor:pointer}.green{background:#25D366;color:white}.gold{background:gold}.red{background:red;color:white}.cert-item{background:#f0f0f0;padding:10px;margin:5px 0;border-radius:8px;display:flex;justify-content:space-between}</style>
</head>
<body>
<h2 style="color:gold;text-align:center">🔐 ADMIN PANEL</h2>
<div id="login" class="card"><h3>Enter Password</h3><input type="password" id="pass" placeholder="Password"><br><button class="gold" onclick="login()">LOGIN</button><p>Default: Arnaud2024</p></div>

<div id="panel" style="display:none">
<div class="card"><h3>Add New Certificate</h3><input id="newId" placeholder="Certificate ID e.g GBAGADA-001" style="text-transform:uppercase"><input id="newSchool" placeholder="School/Student Name"><button class="green" onclick="addCert()">➕ SAVE CERTIFICATE</button><div id="msg"></div></div>

<div class="card"><h3>All Certificates (<span id="count">0</span>)</h3><div id="list"></div><br><button class="gold" onclick="exportCode()">📋 Copy Code For Permanent Save</button><p style="font-size:12px">If you change phone, paste the code into index.html to keep them forever.</p></div>

<div class="card"><a href="index.html" style="text-decoration:none">← Back to Verification Site</a></div>
</div>

<script>
let certs = JSON.parse(localStorage.getItem('arnaud_certs') || '["TEST123","TESTING 123","ARNAUD-001","ARNAUD-002"]');
let schools = JSON.parse(localStorage.getItem('arnaud_schools') || '{}');

function login(){ if(document.getElementById('pass').value==='Arnaud2024'){ document.getElementById('login').style.display='none'; document.getElementById('panel').style.display='block'; showList(); } else alert('Wrong password! Use Arnaud2024'); }
function addCert(){ let id=document.getElementById('newId').value.trim().toUpperCase(); let sch=document.getElementById('newSchool').value.trim(); if(!id){ alert('Enter ID'); return; } if(certs.includes(id)){ alert('Already exists!'); return; } certs.push(id); schools[id]=sch; localStorage.setItem('arnaud_certs',JSON.stringify(certs)); localStorage.setItem('arnaud_schools',JSON.stringify(schools)); document.getElementById('msg').innerHTML='<p style=color:green>✅ '+id+' saved! Live now!</p>'; document.getElementById('newId').value=''; document.getElementById('newSchool').value=''; showList(); }
function deleteCert(id){ if(confirm('Delete '+id+'?')){ certs=certs.filter(c=>c!==id); delete schools[id]; localStorage.setItem('arnaud_certs',JSON.stringify(certs)); localStorage.setItem('arnaud_schools',JSON.stringify(schools)); showList(); } }
function showList(){ document.getElementById('count').innerText=certs.length; let html=''; certs.forEach(id=>{ html+=`<div class=cert-item><span><b>${id}</b><br><small>${schools[id]||''}</small></span><button class=red onclick="deleteCert('${id}')">X</button></div>` }); document.getElementById('list').innerHTML=html||'No certificates yet'; }
function exportCode(){ let code=`const realCertificates = ${JSON.stringify(certs)};`; navigator.clipboard.writeText(code); alert('Copied! Now paste this into index.html line to make permanent:\\n\\n'+code); }
</script>
</body>
</html>
