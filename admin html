<a class="btn" style="background:#333;" href="mailto:arnaudafrochaine5@gmail.com">📧 Email</a>
</div>
<script>
function verifyCertificate() {
  let id = document.getElementById('certId').value.trim().toUpperCase();
  let resultDiv = document.getElementById('result');
  if(id === "") { resultDiv.innerHTML = "⚠️ Please enter Certificate ID"; resultDiv.style.color = "orange"; return; }
  const defaultCerts = ["TEST123","TESTING 123","ARNAUD-001","ARNAUD-002"];
  const savedCerts = JSON.parse(localStorage.getItem('arnaud_certs') || 'null');
  const realCertificates = savedCerts || defaultCerts;
  const schools = JSON.parse(localStorage.getItem('arnaud_schools') || '{}');
  if(realCertificates.includes(id)) {
    let schoolName = schools[id]? "<br><small>"+schools[id]+"</small>" : "";
    resultDiv.innerHTML = "✅ VALID CERTIFICATE<br>" + id + schoolName + "<br>verified by ARNAUD AFROCHAINE";
    resultDiv.style.color = "green";
  } else {
    resultDiv.innerHTML = "❌ INVALID / FAKE CERTIFICATE<br>" + id + " not found";
    resultDiv.style.color = "red";
  }
}
</script>
