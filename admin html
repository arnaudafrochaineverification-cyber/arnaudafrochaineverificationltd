.logo{width:220px;height:220px;border-radius:50%;border:5px solid gold;background:white;object-fit:cover}
h1{font-size:22px;margin:15px 0;color:gold}
.card{background:white;margin:15px;padding:20px;border-radius:15px;box-shadow:0 4px 10px rgba(0,0,0,0.3)}
