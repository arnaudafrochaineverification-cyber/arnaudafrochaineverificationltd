input{width:92%;padding:15px;margin:10px 0;font-size:18px;border:2px solid #0a3d0a;border-radius:10px;text-align:center;text-transform:uppercase}
.verify-btn{background:gold;color:black;padding:15px 30px;font-size:20px;font-weight:bold;border:none;border-radius:10px;cursor:pointer}
#result{margin-top:15px;font-size:18px;font-weight:bold;min-height:30px}
</style>
</head>
<body>
<div class="header">
<img src="IMG-20260917-WA1432.jpg" class="logo" onerror="this.src='logo.png'">
<h1>ARNAUD AFROCHAINE VERIFICATION LTD</h1>
<p style="color:white;">9 okesutedo Baba junction ota, Sango ota, ogun<br>RC: 8604820</p>
</div>
<div class="card">
<p style="font-size:22px;">🔍 Verify Certificate</p>
<input type="text" id="certId" placeholder="Enter Certificate ID">
